#!/bin/sh
### BEGIN INIT INFO
# Provides:          opensrf
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Manage OpenSRF services
# Description:       Controls all OpenSRF services via osrf_control.
### END INIT INFO

NAME=opensrf
DESC="OpenSRF services"
RUNUSER=opensrf
INSTALL_PATH={{ eg_install_path }}
OSRF_CONTROL="$INSTALL_PATH/bin/osrf_control"
OSRF_ARGS="-l --localhost"
PATH_OV="$INSTALL_PATH/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
LD_OV="$INSTALL_PATH/lib:/usr/local/lib:/usr/local/lib/dbd:${LD_LIBRARY_PATH:-}"

[ -x "$OSRF_CONTROL" ] || exit 0

run_osrf() {
    su -s /bin/bash "$RUNUSER" -c "PATH=$PATH_OV LD_LIBRARY_PATH=$LD_OV $OSRF_CONTROL $OSRF_ARGS $*"
}

case "$1" in
  start)
    printf "Starting %s..." "$DESC"
    if run_osrf --start-all; then
        echo "done."
    else
        echo "failed."
        exit 1
    fi
    ;;
  stop)
    printf "Stopping %s..." "$DESC"
    if run_osrf --stop-all; then
        echo "done."
    else
        echo "failed."
        exit 1
    fi
    ;;
  restart|force-reload)
    printf "Restarting %s..." "$DESC"
    if run_osrf --restart-all; then
        echo "done."
    else
        echo "failed."
        exit 1
    fi
    ;;
  status)
    run_osrf --status-all
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|force-reload|status}"
    exit 2
    ;;
esac

exit 0
